# ==============================================================================
# Sentinel AI - Backend Dockerfile (FastAPI)
# ==============================================================================
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /app/requirements.txt

# Copy backend application code
COPY backend /app/backend

# Copy dataset files needed for local ingestion and benchmarking
COPY case_pack.csv /app/case_pack.csv
COPY closed_cases_history.csv /app/closed_cases_history.csv
COPY cases /app/cases
COPY scripts /app/scripts

# Set environment
ENV PYTHONPATH=/app/backend
ENV PYTHONUNBUFFERED=1
ENV API_HOST=0.0.0.0
ENV API_PORT=8001

EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Start FastAPI server (supports Render dynamic $PORT or default 8001)
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8001}"]
