# Sentinel AI Environment Configuration Template

APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8001
FRONTEND_ORIGIN=http://localhost:3000

# Google Gemini API Keys
GOOGLE_API_KEY=

# Central Model Priority Hierarchy (Primary -> Fallbacks)
GEMINI_MODEL_PRIORITY=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-pro,gemini-3.8-flash,gemini-3.5-flash-lite

# Optional Model-Specific API Keys (falls back to GOOGLE_API_KEY if absent)
GEMINI_25_API_KEY=
GEMINI_20_API_KEY=
GEMINI_38_API_KEY=
GEMINI_37_API_KEY=
GEMINI_36_API_KEY=
GEMINI_35_API_KEY=
GEMINI_35_LITE_API_KEY=

# Langfuse Observability Credentials
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# TigerGraph & MCP Configuration
TIGERGRAPH_HOST=http://localhost:9000
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph
TIGERGRAPH_GRAPH=FraudGraph
MCP_SERVER_URL=

# Feature Flags
CASE_MEMORY_ENABLED=true
GRAPHRAG_ENABLED=true
AUDIT_ENABLED=true
DEMO_MODE=false
