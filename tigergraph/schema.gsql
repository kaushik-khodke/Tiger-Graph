// ==============================================================================
// TigerGraph Savanna GSQL Schema Definition (Cloud Compatible)
// Hackathon: TigerGraph x Hacker House Goa (HHGOA) — Fraud Investigation Dataset
// Platform: Sentinel AI — Agentic Fraud Investigation & Next-Best-Action Platform
// ==============================================================================

// ------------------------------------------------------------------------------
// Vertex Definitions
// ------------------------------------------------------------------------------

CREATE VERTEX Customer (
    PRIMARY_ID id STRING,
    created_at DATETIME,
    risk_level STRING
);

CREATE VERTEX Card (
    PRIMARY_ID id STRING,
    network STRING,
    card_type STRING,
    issuer_code STRING,
    status STRING DEFAULT "ACTIVE"
);

CREATE VERTEX Transaction (
    PRIMARY_ID id STRING,
    amt DOUBLE,
    ts DATETIME,
    channel STRING,
    risk_score DOUBLE,
    product_code STRING,
    dist1 DOUBLE,
    dist2 DOUBLE
);

CREATE VERTEX DeviceProfile (
    PRIMARY_ID id STRING,
    device_info STRING,
    os_name STRING,
    browser_name STRING,
    screen_resolution STRING,
    proxy_status STRING,
    is_new_device STRING
);

CREATE VERTEX EmailDomain (
    PRIMARY_ID domain STRING
);

CREATE VERTEX BillingRegion (
    PRIMARY_ID region_code STRING,
    country_code STRING
);

CREATE VERTEX ClosedCase (
    PRIMARY_ID id STRING,
    outcome STRING,
    pattern STRING,
    exposure_usd DOUBLE,
    opened_at DATETIME,
    closed_at DATETIME,
    report_filed STRING,
    analyst_notes STRING
);

CREATE VERTEX InvestigationCase (
    PRIMARY_ID id STRING,
    case_id STRING,
    status STRING,
    verdict STRING,
    fraud_probability DOUBLE,
    pattern STRING,
    pattern_description STRING,
    exposure_usd DOUBLE,
    summary STRING,
    stop_reason STRING,
    sar_filed BOOL,
    resolved_at DATETIME
);

// ------------------------------------------------------------------------------
// Edge Definitions
// ------------------------------------------------------------------------------

CREATE UNDIRECTED EDGE OWNS (FROM Customer, TO Card);

CREATE UNDIRECTED EDGE MADE (FROM Card, TO Transaction);

CREATE UNDIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile);

CREATE UNDIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain);

CREATE UNDIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion);

CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction, delta_seconds INT);

CREATE UNDIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction);

CREATE UNDIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card);

CREATE UNDIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card);

CREATE UNDIRECTED EDGE INVESTIGATED_CARD (FROM InvestigationCase, TO Card);

CREATE UNDIRECTED EDGE INVESTIGATED_TXN (FROM InvestigationCase, TO Transaction);

CREATE UNDIRECTED EDGE IDENTIFIED_DEVICE (FROM InvestigationCase, TO DeviceProfile);
